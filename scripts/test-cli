#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache_dir="${ZIGAI_GLOBAL_CACHE_DIR:-$project_dir/.zig-global-cache}"

cd "$project_dir"
ZIG_GLOBAL_CACHE_DIR="$cache_dir" zig build
python3 tests/fake_provider_server.py &
server_pid=$!
trap 'kill "$server_pid" 2>/dev/null || true' EXIT INT TERM
sleep 1

openai_output=$(OPENAI_API_KEY=test OPENAI_BASE_URL=http://127.0.0.1:18765/openai ./zig-out/bin/zigai-openai test)
anthropic_output=$(ANTHROPIC_API_KEY=test ANTHROPIC_BASE_URL=http://127.0.0.1:18765/anthropic ./zig-out/bin/zigai-anthropic test)
google_output=$(GEMINI_API_KEY=test GEMINI_BASE_URL=http://127.0.0.1:18765/google ./zig-out/bin/zigai-google test)
openai_stream_output=$(OPENAI_API_KEY=test OPENAI_BASE_URL=http://127.0.0.1:18765/openai ./zig-out/bin/zigai-openai --stream test)
anthropic_stream_output=$(ANTHROPIC_API_KEY=test ANTHROPIC_BASE_URL=http://127.0.0.1:18765/anthropic ./zig-out/bin/zigai-anthropic --stream test)
google_stream_output=$(GEMINI_API_KEY=test GEMINI_BASE_URL=http://127.0.0.1:18765/google ./zig-out/bin/zigai-google --stream test)
openai_tool_output=$(OPENAI_API_KEY=test OPENAI_BASE_URL=http://127.0.0.1:18765/openai ./zig-out/bin/zigai-openai --tools tests/cli_tools.json test)
anthropic_tool_output=$(ANTHROPIC_API_KEY=test ANTHROPIC_BASE_URL=http://127.0.0.1:18765/anthropic ./zig-out/bin/zigai-anthropic --tools tests/cli_tools.json test)
google_tool_output=$(GEMINI_API_KEY=test GEMINI_BASE_URL=http://127.0.0.1:18765/google ./zig-out/bin/zigai-google --tools tests/cli_tools.json test)
openai_stream_tool_output=$(OPENAI_API_KEY=test OPENAI_BASE_URL=http://127.0.0.1:18765/openai ./zig-out/bin/zigai-openai --stream --tools tests/cli_tools.json test)
anthropic_stream_tool_output=$(ANTHROPIC_API_KEY=test ANTHROPIC_BASE_URL=http://127.0.0.1:18765/anthropic ./zig-out/bin/zigai-anthropic --stream --tools tests/cli_tools.json test)
google_stream_tool_output=$(GEMINI_API_KEY=test GEMINI_BASE_URL=http://127.0.0.1:18765/google ./zig-out/bin/zigai-google --stream --tools tests/cli_tools.json test)

production_dir=$(mktemp -d)
trap 'kill "$server_pid" 2>/dev/null || true; rm -rf "$production_dir"' EXIT INT TERM
cat >"$production_dir/config.json" <<EOF
{"provider":"openai","model":"gpt-5-mini","base_url":"http://127.0.0.1:18765/openai","history_path":"$production_dir/history.json"}
EOF
production_output=$(OPENAI_API_KEY=test ./zig-out/bin/zigai --config "$production_dir/config.json" test)
production_stdin_output=$(printf 'test\n' | OPENAI_API_KEY=test ./zig-out/bin/zigai --config "$production_dir/config.json" -)
production_json_output=$(OPENAI_API_KEY=test ./zig-out/bin/zigai --config "$production_dir/config.json" --json test)
production_events_output=$(OPENAI_API_KEY=test ./zig-out/bin/zigai --config "$production_dir/config.json" --events test)
production_completion=$(./zig-out/bin/zigai completion bash)
cat >"$production_dir/approval.json" <<EOF
{"provider":"openai","model":"gpt-5-mini","base_url":"http://127.0.0.1:18765/openai","tools_path":"tests/cli_tools.json","require_tool_approval":true,"paused_path":"$production_dir/paused.json"}
EOF
set +e
production_approval_output=$(OPENAI_API_KEY=test ./zig-out/bin/zigai --config "$production_dir/approval.json" test)
production_approval_code=$?
set -e
test "$production_approval_code" -eq 10
production_resume_output=$(OPENAI_API_KEY=test ./zig-out/bin/zigai --config "$production_dir/approval.json" --resume --approval approve)
if OPENAI_API_KEY= ./zig-out/bin/zigai --config "$production_dir/config.json" test >/dev/null 2>&1; then
    echo "production CLI unexpectedly accepted an empty credential" >&2
    exit 1
else
    test "$?" -eq 4
fi

test "$openai_output" = pong
test "$anthropic_output" = pong
test "$google_output" = pong
test "$openai_stream_output" = pong
test "$anthropic_stream_output" = pong
test "$google_stream_output" = pong
test "$openai_tool_output" = pong
test "$anthropic_tool_output" = pong
test "$google_tool_output" = pong
test "$openai_stream_tool_output" = pong
test "$anthropic_stream_tool_output" = pong
test "$google_stream_tool_output" = pong
test "$production_output" = pong
test "$production_stdin_output" = pong
test "$production_resume_output" = pong
printf '%s\n' "$production_approval_output" | grep -q '"status":"approval_required"'
printf '%s' "$production_json_output" | python3 -c 'import json,sys; assert json.load(sys.stdin)["output"] == "pong"'
printf '%s\n' "$production_events_output" | grep -q '"type":"RUN_STARTED"'
printf '%s\n' "$production_events_output" | grep -q '"type":"RUN_FINISHED"'
printf '%s\n' "$production_completion" | grep -q '^complete '
test -s "$production_dir/history.json"
echo "All provider CLIs passed against the local fixture."
