#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache_dir="${ZIGAI_GLOBAL_CACHE_DIR:-$project_dir/.zig-global-cache}"
iterations="${1:-1000}"

case "$iterations" in
    ''|*[!0-9KMG]*|*[KMG]*[KMG]*)
        echo "usage: ./scripts/fuzz [iterations|iterationsK|iterationsM|iterationsG]" >&2
        exit 2
        ;;
esac

case "$iterations" in
    [KMG]|*[KMG][0-9]*)
        echo "usage: ./scripts/fuzz [iterations|iterationsK|iterationsM|iterationsG]" >&2
        exit 2
        ;;
esac

cd "$project_dir"
ZIG_GLOBAL_CACHE_DIR="$cache_dir" zig build test --fuzz="$iterations" -Derror-tracing=false
